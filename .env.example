# ── Redact-PDF-NoOCR configuration ─────────────────────────────────────
# Copy to `.env` (project root) and adjust. Environment variables win over
# this file. Everything works with any OpenAI-compatible vision endpoint.

# Your Qwen server (self-hosted example). Default: OpenRouter.
# REDACT_API_URL=http://qwen.internal.example:8000/v1/chat/completions

# Model id as known by the endpoint.
# Default: qwen/qwen3-vl-235b-a22b-instruct  (OpenRouter id)
# REDACT_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# API key for the endpoint (any of these names works:
# REDACT_API_KEY, OPENROUTER_KEY, QWEN_KEY, OPENAI_API_KEY)
REDACT_API_KEY=

# Where redacted PDFs are written (default: ./redacted inside the project)
# REDACT_OUT_DIR=/path/to/output

# Web UI port (default 8799)
# REDACT_PORT=8799
